---
import { personalInfo } from '../data/portfolioData';

const pillars = [
  {
    color: "rk-fill-lime",
    title: "Relentless Automation",
    desc: "If an operational task repeats more than twice a day, it belongs in an automated pipeline.",
  },
  {
    color: "rk-fill-sky",
    title: "100% Data Rigor",
    desc: "Formula-level validation, multi-user concurrency locks, and zero tolerance for human calculation slips.",
  },
  {
    color: "rk-fill-butter",
    title: "Actionable Intelligence",
    desc: "Transforming opaque data columns into executive dashboards that spark immediate, clear decisions.",
  },
  {
    color: "rk-fill-pink",
    title: "SLA Discipline",
    desc: "Establishing bulletproof standard operating procedures (SOPs) that ensure predictable on-time delivery.",
  },
];
---

<section id="about" class="py-20 border-t border-[var(--line)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    <div class="mb-12">
      <span class="rk-eyebrow">01 · ABOUT ME</span>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink)] mt-2">
        Bridging the gap between messy logistics and automated clarity<span class="text-[var(--red)]">.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left: Story Narrative (7 cols) -->
      <div class="lg:col-span-7 space-y-6 text-[var(--ink-soft)] text-base sm:text-lg leading-relaxed font-sans-clean">
        <p>
          I am an <strong class="text-[var(--ink)] font-bold">Operations & Data Analytics Professional</strong> who believes that operational efficiency isn’t about working longer hours—it’s about eliminating manual friction with intelligent tooling.
        </p>
        <p>
          In fast-paced organizations, teams often find themselves buried under disconnected spreadsheets, conflicting records, and hours of copy-pasting. That’s where I step in. By mastering advanced Microsoft Excel architecture, building Google Apps Script triggers, and designing visual dashboards, I transform slow, error-prone workflows into high-speed, automated machines.
        </p>
        <p class="text-sm sm:text-base text-[var(--ink-muted)]">
          My experience spans cross-departmental coordination, SLA management, and end-to-end data pipelines that give leadership total transparency while empowering operational agents to do their best work without stress.
        </p>

        <!-- Quick location and status pills -->
        <div class="pt-4 flex flex-wrap gap-2">
          <span class="rk-sticker rk-fill-sky" style="transform: rotate(-1deg);">Dhaka, Bangladesh</span>
          <span class="rk-sticker rk-fill-butter" style="transform: rotate(1.5deg);">Open to Global / Remote</span>
          <span class="rk-sticker rk-fill-lime" style="transform: rotate(-2deg);">Full-Time & High-Impact Contracts</span>
        </div>
      </div>

      <!-- Right: Core Pillars (5 cols) with square dots like Rifat's skills section -->
      <div class="lg:col-span-5 space-y-4">
        {pillars.map((pillar) => (
          <div class="rk-card p-5 flex items-start gap-4">
            <span class={`w-4 h-4 rounded-md shrink-0 mt-1 border border-[var(--ink)] ${pillar.color}`} aria-hidden="true"></span>
            <div>
              <h3 class="font-display font-bold text-base text-[var(--ink)]">
                {pillar.title}
              </h3>
              <p class="text-xs sm:text-sm text-[var(--ink-muted)] mt-1 font-sans-clean leading-relaxed">
                {pillar.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
