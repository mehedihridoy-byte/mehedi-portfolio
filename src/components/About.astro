---
import { personalInfo, educationData, certificationsList } from '../data/portfolioData';

const pillars = [
  {
    color: "rk-fill-lime",
    title: "Relentless Automation",
    desc: "If an operational task repeats more than twice a day, it belongs in an automated Apps Script or formula pipeline.",
  },
  {
    color: "rk-fill-sky",
    title: "100% Data Rigor",
    desc: "Formula-level validation, multi-user row locking, and zero tolerance for human calculation slips.",
  },
  {
    color: "rk-fill-butter",
    title: "Actionable Intelligence",
    desc: "Transforming opaque rows and columns into visual KPI dashboards that spark immediate decisions.",
  },
  {
    color: "rk-fill-pink",
    title: "SLA & Team Leadership",
    desc: "Proven track record leading 6-member operational teams with standardized SOPs and 99.8% on-time execution.",
  },
];
---

<section id="about" class="py-20 border-t border-[var(--line)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    <div class="mb-12">
      <span class="rk-eyebrow">01 · ABOUT ME</span>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink)] mt-2">
        Scaling high-volume operations with automated precision<span class="text-[var(--red)]">.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left: Story Narrative (7 cols) -->
      <div class="lg:col-span-7 space-y-6 text-[var(--ink-soft)] text-base sm:text-lg leading-relaxed font-sans-clean">
        <p>
          I am an <strong class="text-[var(--ink)] font-bold">Operations & Advanced Spreadsheet Specialist</strong> with over 5 years of hands-on experience in operations management, process automation, and data analysis.
        </p>
        <p>
          Currently, as <strong class="text-[var(--ink)] font-semibold">Operations Lead at Shikho Technologies Bangladesh</strong>, I lead a direct 6-member operational team managing high-stakes operations & content workflows across 7 studios—having scaled over <strong class="text-[var(--ink)] font-semibold">12,000+ workflows</strong> and personally QA-monitored 4,200+ sessions. To keep this velocity sustainable, I built automated Google Sheets and Google Apps Script management systems that track schedules, prevent scheduling collisions, and eliminate hours of manual reporting.
        </p>
        <p class="text-sm sm:text-base text-[var(--ink-muted)]">
          <strong class="text-[var(--ink)] font-semibold">Why I work with external clients:</strong> Growing businesses often lose dozens of hours every week because their spreadsheets are fragmented, formulas break, or data entry is entirely manual. I partner with business owners and managers to architect bulletproof Google Sheets, dynamic Excel models, and automated Apps Script pipelines tailored to their exact workflow.
        </p>

        <!-- Education & Certifications snippet -->
        <div class="p-5 rounded-2xl bg-[var(--surface)] border border-[var(--line)] space-y-3 font-mono-clean text-xs">
          <div class="flex items-center justify-between pb-2 border-b border-[var(--line)]">
            <span class="text-[var(--ink-muted)] uppercase tracking-wider font-bold">EDUCATION & TRAINING</span>
            <span class="text-[var(--ink)] font-semibold">National University (2024)</span>
          </div>
          <div class="flex flex-wrap gap-2 pt-1">
            {certificationsList.map((cert) => (
              <span class="px-2 py-0.5 rounded bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)]">
                {cert}
              </span>
            ))}
          </div>
        </div>

        <!-- Quick location and status pills -->
        <div class="pt-2 flex flex-wrap gap-2">
          <span class="rk-sticker rk-fill-sky" style="transform: rotate(-1deg);">{personalInfo.location}</span>
          <span class="rk-sticker rk-fill-butter" style="transform: rotate(1.5deg);">Open for Client Work</span>
          <span class="rk-sticker rk-fill-lime" style="transform: rotate(-2deg);">{personalInfo.phone}</span>
        </div>
      </div>

      <!-- Right: Core Pillars (5 cols) with square dots like Rifat's skills section -->
      <div class="lg:col-span-5 space-y-4">
        {pillars.map((pillar) => (
          <div class="rk-card p-5 flex items-start gap-4">
            <span class={`w-4 h-4 rounded-md shrink-0 mt-1 border border-[var(--ink)] ${pillar.color}`} aria-hidden="true"></span>
            <div>
              <h3 class="font-display font-bold text-base text-[var(--ink)]">
                {pillar.title}
              </h3>
              <p class="text-xs sm:text-sm text-[var(--ink-muted)] mt-1 font-sans-clean leading-relaxed">
                {pillar.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
