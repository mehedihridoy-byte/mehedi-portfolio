---
import { CheckCircle2, Target, Zap, Shield, Sparkles, MapPin, Mail, Award, Clock } from 'lucide-astro';
import { personalInfo } from '../data/portfolioData';

const coreValues = [
  {
    icon: Target,
    title: "Business-First Analytics",
    desc: "Data is useless without business context. I focus on actionable metrics that cut overhead and accelerate decision-making.",
  },
  {
    icon: Zap,
    title: "Relentless Automation",
    desc: "If a task is repeated more than twice a day, it should be automated. I build zero-touch pipelines that save hours daily.",
  },
  {
    icon: Shield,
    title: "Bulletproof Data Integrity",
    desc: "From complex Excel models to multi-agent Google Sheets, I engineer strict validation logic to eliminate human error.",
  },
  {
    icon: Clock,
    title: "Operational SLA Rigor",
    desc: "Disciplined execution, clear documentation, robust SOPs, and proactive bottleneck detection ensure consistent delivery.",
  },
];
---

<section id="about" class="py-16 md:py-24 relative border-t border-white/[0.05]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Heading -->
    <div class="space-y-2 mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-medium text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
        <Sparkles class="w-3.5 h-3.5" />
        <span>ABOUT ME</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Turning Operational Chaos into Clean, Automated Value
      </h2>
      <p class="text-slate-400 max-w-2xl text-base">
        A look into my professional background, operational mindset, and commitment to precision.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Main Story / Background Card (7 cols) -->
      <div class="lg:col-span-7 bento-card p-6 sm:p-8 space-y-5 flex flex-col justify-between">
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-white flex items-center gap-2">
            Professional Overview
          </h3>
          <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
            I am an <strong class="text-white font-semibold">Operations & Data Analytics Professional</strong> with a deep passion for unlocking business efficiency. Rather than treating operations and data analysis as isolated silos, I bridge the two—leveraging advanced spreadsheet engineering, custom scripting, and analytical modeling to solve real-world logistical bottlenecks.
          </p>
          <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
            My career has been centered around high-velocity operational environments where hundreds of data points, team handoffs, and customer interactions happen every hour. In these settings, manual errors or slow reporting can stall an entire organization. My mission is to build robust, scalable systems that give leadership total clarity while liberating teams from soul-crushing manual data entry.
          </p>
          <p class="text-slate-400 leading-relaxed text-sm">
            Whether it’s formulating dynamic multi-tab financial engines in Microsoft Excel, deploying real-time multi-agent Google Sheets via Google Apps Script, or coding custom web tracking utilities, I deliver measurable results that impact the bottom line.
          </p>
        </div>

        <!-- Quick Info Pills -->
        <div class="pt-6 border-t border-white/[0.06] grid grid-cols-2 sm:grid-cols-3 gap-3 font-mono text-xs">
          <div class="bg-slate-900/50 p-3 rounded-lg border border-white/[0.04]">
            <span class="text-slate-400 block text-[10px]">LOCATION</span>
            <span class="text-slate-200 font-medium">Dhaka, Bangladesh</span>
          </div>
          <div class="bg-slate-900/50 p-3 rounded-lg border border-white/[0.04]">
            <span class="text-slate-400 block text-[10px]">EXPERIENCE</span>
            <span class="text-emerald-400 font-medium">3+ Years Ops & Data</span>
          </div>
          <div class="bg-slate-900/50 p-3 rounded-lg border border-white/[0.04] col-span-2 sm:col-span-1">
            <span class="text-slate-400 block text-[10px]">COLLABORATION</span>
            <span class="text-cyan-400 font-medium">Remote & Global</span>
          </div>
        </div>
      </div>

      <!-- Core Principles Cards (5 cols) -->
      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
        {coreValues.map((value) => {
          const Icon = value.icon;
          return (
            <div class="bento-card p-5 hover:border-emerald-500/30 transition-all flex items-start gap-4">
              <div class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0">
                <Icon class="w-5 h-5" />
              </div>
              <div class="space-y-1">
                <h4 class="text-sm font-semibold text-white">
                  {value.title}
                </h4>
                <p class="text-xs text-slate-400 leading-relaxed">
                  {value.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
