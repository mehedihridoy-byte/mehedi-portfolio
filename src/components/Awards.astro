---
import { awardsData } from '../data/portfolioData';
---

<section id="awards" class="py-20 border-t border-[var(--line)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    <div class="mb-14">
      <span class="rk-eyebrow">06 · RECOGNITION</span>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink)] mt-2">
        Honors & achievements<span class="text-[var(--red)]">.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {awardsData.map((award, idx) => (
        <div class="rk-card p-6 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between pb-3 border-b border-[var(--line)]">
              <span class="rk-sticker rk-fill-butter text-xs font-mono-clean">
                ★ {award.year}
              </span>
              <span class="font-mono-clean text-xs text-[var(--ink-muted)]">
                0{idx + 1}
              </span>
            </div>

            <div>
              <h3 class="font-display text-lg font-bold text-[var(--ink)]">
                {award.title}
              </h3>
              <p class="font-mono-clean text-xs text-[var(--red)] mt-0.5">
                {award.issuer}
              </p>
            </div>

            <p class="font-sans-clean text-xs sm:text-sm text-[var(--ink-soft)] leading-relaxed pt-1">
              {award.description}
            </p>
          </div>

          <div class="pt-3 border-t border-[var(--line)] font-mono-clean text-[11px] text-[var(--ink-muted)]">
            Verified Operational Impact
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
