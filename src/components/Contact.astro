---
import { personalInfo } from '../data/portfolioData';
---

<section id="contact" class="py-20 border-t border-[var(--line)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    <div class="rk-card p-8 sm:p-14 bg-[var(--surface)] space-y-8 relative overflow-hidden">
      <!-- Top Sticker & Eyebrow -->
      <div class="flex flex-wrap items-center gap-3">
        <span class="rk-sticker rk-fill-lime" style="transform: rotate(-1.5deg);">
          Open for spreadsheet & ops projects ✓
        </span>
        <span class="rk-eyebrow">07 · CONTACT</span>
      </div>

      <!-- Main Headline with Red Squiggle -->
      <h2 class="font-display text-4xl sm:text-6xl md:text-7xl font-extrabold text-[var(--ink)] leading-[1.05] tracking-tight">
        Let's compare<br />
        <span class="rk-squiggle">
          notes
          <svg viewBox="0 0 600 28" preserveAspectRatio="none" aria-hidden="true">
            <path d="M4 16 Q 40 2 76 16 T 148 16 T 220 16 T 292 16 T 364 16 T 436 16 T 508 16 T 580 16" fill="none" stroke="var(--red)" stroke-width="7" stroke-linecap="round"></path>
          </svg>
        </span><span class="text-[var(--red)]">.</span>
      </h2>

      <!-- Content Row: Copy & Live Clock -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pt-4">
        <!-- Copy & Action Buttons (8 cols) -->
        <div class="lg:col-span-8 space-y-6">
          <p class="font-sans-clean text-lg sm:text-xl text-[var(--ink-soft)] leading-relaxed max-w-xl">
            Drowning in messy Excel or Google Sheets, need custom Apps Script or VBA automations, or want a dynamic KPI dashboard built from scratch? Whatever your spreadsheet needs—whether project consulting or a full-time operational lead—let's connect.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="https://wa.me/8801970300717"
              target="_blank"
              rel="noopener noreferrer"
              class="rk-btn rk-btn--ink font-mono-clean text-xs whitespace-nowrap"
            >
              WhatsApp (+880 1970 300 717) ↗
            </a>
            <a
              href={`mailto:${personalInfo.email}`}
              class="rk-btn rk-btn--out font-mono-clean text-xs whitespace-nowrap"
            >
              {personalInfo.email}
            </a>
            <a
              href={personalInfo.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="rk-btn rk-btn--out font-mono-clean text-xs whitespace-nowrap"
            >
              LinkedIn ↗
            </a>
          </div>
        </div>

        <!-- Live Dhaka Clock Widget (4 cols) (Exact signature widget with stable tabular numbers) -->
        <div class="lg:col-span-4 w-full flex justify-center lg:justify-end">
          <div class="w-full max-w-[340px] p-6 sm:p-7 rounded-2xl bg-[var(--paper)] border border-[var(--ink)] shadow-[var(--shadow-card)] text-center space-y-2 flex flex-col justify-center items-center">
            <div class="font-mono-clean text-[11px] font-bold uppercase tracking-widest text-[var(--ink-muted)]">
              IN DHAKA IT'S
            </div>
            <!-- Monospace tabular numbers to prevent horizontal shifting/jitter -->
            <div
              id="dhaka-clock"
              class="font-mono-clean font-bold text-3xl sm:text-4xl text-[var(--ink)] tracking-tight tabular-nums select-none min-h-[44px] flex items-center justify-center w-full"
              style="font-variant-numeric: tabular-nums; font-feature-settings: 'tnum';"
            >
              --:--:-- --
            </div>
            <div class="font-mono-clean text-[11px] font-semibold text-[var(--red)] tracking-wider">
              GMT+6 · USUALLY ONLINE
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function updateDhakaClock() {
    const clockEl = document.getElementById('dhaka-clock');
    if (!clockEl) return;

    try {
      const now = new Date();
      // Format time in Dhaka (Asia/Dhaka GMT+6) with fixed width components
      const options: Intl.DateTimeFormatOptions = {
        timeZone: 'Asia/Dhaka',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true,
      };
      const formatter = new Intl.DateTimeFormat('en-US', options);
      clockEl.textContent = formatter.format(now);
    } catch {
      const local = new Date();
      clockEl.textContent = local.toLocaleTimeString();
    }
  }

  updateDhakaClock();
  setInterval(updateDhakaClock, 1000);
</script>
