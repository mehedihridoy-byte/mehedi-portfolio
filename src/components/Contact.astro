---
import { Mail, Linkedin, Github, FileDown, Copy, Check, Send, Sparkles, MapPin, ArrowUpRight } from 'lucide-astro';
import { personalInfo } from '../data/portfolioData';
---

<section id="contact" class="py-16 md:py-24 relative border-t border-white/[0.05]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="bento-card p-6 sm:p-10 border border-white/[0.08] relative overflow-hidden">
      <!-- Glow ambient lights -->
      <div class="absolute -top-32 -right-32 w-80 h-80 bg-emerald-500/10 blur-[130px] rounded-full pointer-events-none"></div>
      <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-cyan-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Pitch & Details -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 text-xs font-mono font-medium text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
              <Sparkles class="w-3.5 h-3.5" />
              <span>GET IN TOUCH</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
              Let's Discuss How We Can Optimize Your Operations
            </h2>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              Whether you are hiring for an operational leadership role, seeking a data analytics specialist, or looking to automate complex spreadsheet workflows—I'd love to connect.
            </p>
          </div>

          <!-- Contact Quick Cards -->
          <div class="space-y-3 pt-2">
            <!-- Email Item with Copy Button -->
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-white/[0.06] hover:border-emerald-500/30 transition-all">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center">
                  <Mail class="w-4 h-4" />
                </div>
                <div>
                  <span class="text-[10px] font-mono text-slate-500 block">PRIMARY EMAIL</span>
                  <a href={`mailto:${personalInfo.email}`} class="text-xs sm:text-sm font-mono text-slate-200 hover:text-emerald-400 transition-colors">
                    {personalInfo.email}
                  </a>
                </div>
              </div>
              <button
                id="copy-email-btn"
                data-email={personalInfo.email}
                aria-label="Copy Email Address"
                class="p-2 rounded-lg bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 transition-colors text-xs flex items-center gap-1.5 font-mono"
              >
                <Copy id="copy-icon" class="w-3.5 h-3.5" />
                <Check id="check-icon" class="w-3.5 h-3.5 text-emerald-400 hidden" />
                <span id="copy-text">Copy</span>
              </button>
            </div>

            <!-- Social Links Grid -->
            <div class="grid grid-cols-2 gap-3">
              <a
                href={personalInfo.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-white/[0.06] hover:border-emerald-500/30 transition-all group"
              >
                <div class="flex items-center gap-2.5">
                  <Linkedin class="w-4 h-4 text-cyan-400" />
                  <span class="text-xs font-mono text-slate-200 group-hover:text-cyan-300">LinkedIn</span>
                </div>
                <ArrowUpRight class="w-3.5 h-3.5 text-slate-500 group-hover:text-cyan-400 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </a>

              <a
                href={personalInfo.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-white/[0.06] hover:border-emerald-500/30 transition-all group"
              >
                <div class="flex items-center gap-2.5">
                  <Github class="w-4 h-4 text-slate-200" />
                  <span class="text-xs font-mono text-slate-200 group-hover:text-emerald-300">GitHub</span>
                </div>
                <ArrowUpRight class="w-3.5 h-3.5 text-slate-500 group-hover:text-emerald-400 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Direct Message Form Box -->
        <div class="lg:col-span-5 bg-slate-900/90 p-6 sm:p-7 rounded-2xl border border-white/[0.08] shadow-2xl space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
            <h3 class="text-sm font-bold text-white font-mono uppercase tracking-wider">
              Send a Quick Message
            </h3>
            <span class="text-[11px] font-mono text-emerald-400">Response within 24h</span>
          </div>

          <form
            action={`mailto:${personalInfo.email}`}
            method="POST"
            enctype="text/plain"
            class="space-y-3 font-mono text-xs"
          >
            <div>
              <label class="block text-slate-400 mb-1">Your Name / Organization</label>
              <input
                type="text"
                name="name"
                required
                placeholder="e.g. John Doe / Tech Corp"
                class="w-full px-3 py-2 rounded-lg bg-slate-950/80 border border-white/[0.08] text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors"
              />
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Your Email</label>
              <input
                type="email"
                name="email"
                required
                placeholder="john@example.com"
                class="w-full px-3 py-2 rounded-lg bg-slate-950/80 border border-white/[0.08] text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors"
              />
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Subject / Project Type</label>
              <select
                name="subject"
                class="w-full px-3 py-2 rounded-lg bg-slate-950/80 border border-white/[0.08] text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors"
              >
                <option value="Full-Time Opportunity">Full-Time / Contract Role</option>
                <option value="Workflow Automation Project">Workflow Automation Project</option>
                <option value="Excel / Sheets Consulting">Excel / Google Sheets Consulting</option>
                <option value="General Inquiry">General Networking</option>
              </select>
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Message</label>
              <textarea
                name="message"
                rows="3"
                required
                placeholder="Briefly describe what you have in mind..."
                class="w-full px-3 py-2 rounded-lg bg-slate-950/80 border border-white/[0.08] text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold transition-colors flex items-center justify-center gap-2 shadow-md shadow-emerald-500/20"
            >
              <Send class="w-3.5 h-3.5" />
              <span>Send Message</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const copyText = document.getElementById('copy-text');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email') || '';
    if (email) {
      await navigator.clipboard.writeText(email);
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      if (copyText) copyText.textContent = 'Copied!';
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        if (copyText) copyText.textContent = 'Copy';
      }, 2000);
    }
  });
</script>
