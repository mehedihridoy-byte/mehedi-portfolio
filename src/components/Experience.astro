---
import { experienceData } from '../data/portfolioData';
---

<section id="experience" class="py-20 border-t border-[var(--line)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    <div class="mb-14">
      <span class="rk-eyebrow">04 · EXPERIENCE</span>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink)] mt-2">
        Career history & leadership<span class="text-[var(--red)]">.</span>
      </h2>
    </div>

    <!-- Timeline Cards -->
    <div class="space-y-8">
      {experienceData.map((item) => (
        <div class="rk-card p-6 sm:p-8 space-y-5">
          <!-- Role & Period Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-[var(--line)]">
            <div>
              <h3 class="font-display text-2xl font-bold text-[var(--ink)]">
                {item.role}
              </h3>
              <div class="font-sans-clean text-sm text-[var(--ink-muted)] mt-0.5">
                <span class="font-semibold text-[var(--ink)]">{item.company}</span> · {item.location}
              </div>
            </div>

            <span class="rk-sticker rk-fill-butter text-xs self-start sm:self-auto font-mono-clean">
              {item.period}
            </span>
          </div>

          <p class="font-sans-clean text-sm sm:text-base text-[var(--ink-soft)] leading-relaxed">
            {item.description}
          </p>

          <!-- Key Accomplishments -->
          <div class="space-y-2 pt-2">
            <span class="font-mono-clean text-xs uppercase tracking-wider text-[var(--ink-muted)] block">
              Core Achievements:
            </span>
            <ul class="space-y-2 font-sans-clean text-xs sm:text-sm text-[var(--ink-soft)]">
              {item.achievements.map((ach) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--red)] font-bold">✓</span>
                  <span>{ach}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Skills tags -->
          <div class="pt-4 border-t border-[var(--line)] flex flex-wrap gap-1.5 font-mono-clean text-xs">
            {item.skills.map((skill) => (
              <span class="px-2.5 py-1 rounded-md border border-[var(--line)] bg-[var(--paper)] text-[var(--ink-soft)]">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
