---
import { Briefcase, Calendar, MapPin, Sparkles, CheckCircle2 } from 'lucide-astro';
import { experienceData } from '../data/portfolioData';
---

<section id="experience" class="py-16 md:py-24 relative border-t border-white/[0.05]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Heading -->
    <div class="space-y-2 mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-medium text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
        <Sparkles class="w-3.5 h-3.5" />
        <span>CAREER HISTORY</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Professional Experience & Track Record
      </h2>
      <p class="text-slate-400 max-w-2xl text-base">
        A timeline of leadership in operational efficiency, spreadsheet modeling, and cross-team coordination.
      </p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative pl-6 sm:pl-8 border-l border-white/[0.1] space-y-12">
      {experienceData.map((item) => (
        <div class="relative group">
          <!-- Timeline Node Bullet -->
          <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-[#07090E] border-2 border-emerald-400 group-hover:bg-emerald-400 group-hover:scale-125 transition-all shadow-md shadow-emerald-500/20"></div>

          <!-- Card Content -->
          <div class="bento-card p-6 sm:p-8 space-y-5 border border-white/[0.08] hover:border-emerald-500/30 transition-all">
            <!-- Header: Role, Period, Company -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-white/[0.06]">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-emerald-300 transition-colors">
                  {item.role}
                </h3>
                <div class="text-sm text-emerald-400 font-medium mt-0.5 flex items-center gap-2">
                  <span>{item.company}</span>
                  <span class="text-slate-600">•</span>
                  <span class="text-xs text-slate-400 flex items-center gap-1 font-mono">
                    <MapPin class="w-3 h-3" /> {item.location}
                  </span>
                </div>
              </div>

              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900 border border-white/[0.06] text-xs font-mono text-slate-300 self-start sm:self-auto">
                <Calendar class="w-3.5 h-3.5 text-emerald-400" />
                <span>{item.period}</span>
              </div>
            </div>

            <p class="text-sm text-slate-300 leading-relaxed">
              {item.description}
            </p>

            <!-- Key Achievements List -->
            <div class="space-y-2 pt-2">
              <span class="text-xs font-mono uppercase tracking-wider text-slate-400 block">
                Key Accomplishments:
              </span>
              <ul class="space-y-2">
                {item.achievements.map((ach) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
                    <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
                    <span>{ach}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Skills Used -->
            <div class="pt-4 border-t border-white/[0.06] flex flex-wrap gap-1.5">
              {item.skills.map((skill) => (
                <span class="text-xs font-mono px-2.5 py-1 rounded bg-slate-900/90 text-slate-300 border border-white/[0.05]">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
