---
import { coreExpertise } from '../data/portfolioData';

const stickerColors = ["rk-fill-lime", "rk-fill-sky", "rk-fill-butter", "rk-fill-pink", "rk-fill-lime", "rk-fill-sky"];
---

<section id="expertise" class="py-20 border-t border-[var(--line)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <span class="rk-eyebrow">02 · CORE EXPERTISE</span>
        <h2 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink)] mt-2">
          Specialized Competencies<span class="text-[var(--red)]">.</span>
        </h2>
      </div>
      <span class="font-mono-clean text-xs text-[var(--ink-muted)]">
        6 Operational & Analytical Pillars
      </span>
    </div>

    <!-- 3x2 Grid with Hard Shadows -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {coreExpertise.map((item, idx) => (
        <div class="rk-card p-6 flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class={`rk-sticker ${stickerColors[idx % stickerColors.length]} text-[10px]`}>
                0{idx + 1} · CORE
              </span>
            </div>

            <h3 class="font-display text-xl font-bold text-[var(--ink)]">
              {item.title}
            </h3>

            <p class="text-sm text-[var(--ink-soft)] font-sans-clean leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="pt-4 border-t border-[var(--line)] flex flex-wrap gap-1.5 font-mono-clean text-[11px]">
            {item.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded-md border border-[var(--line)] bg-[var(--paper)] text-[var(--ink-soft)]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
