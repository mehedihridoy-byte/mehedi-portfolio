---
import { Heart, ArrowUp, Linkedin, Github, Mail } from 'lucide-astro';
import { personalInfo } from '../data/portfolioData';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.06] bg-[#06080C] py-12 relative z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Left: Identity & Copyright -->
      <div class="flex flex-col items-center md:items-start gap-1">
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold text-white tracking-wide">Md. Mehedi Hassan</span>
          <span class="text-slate-600">•</span>
          <span class="text-xs text-slate-400 font-mono">Operations & Data Analytics</span>
        </div>
        <p class="text-xs text-slate-500 font-mono">
          &copy; {currentYear} Md. Mehedi Hassan. All rights reserved.
        </p>
      </div>

      <!-- Center: Tech Disclosure (Astro + Tailwind) -->
      <div class="flex items-center gap-2 text-xs font-mono text-slate-400 bg-slate-900/60 px-3.5 py-1.5 rounded-full border border-white/[0.05]">
        <span>Built with</span>
        <span class="text-emerald-400 font-semibold">Astro</span>
        <span>&</span>
        <span class="text-cyan-400 font-semibold">Tailwind CSS</span>
      </div>

      <!-- Right: Social Links & Back to Top -->
      <div class="flex items-center gap-4 text-slate-400">
        <a
          href={personalInfo.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="hover:text-emerald-400 transition-colors"
        >
          <Linkedin class="w-4 h-4" />
        </a>
        <a
          href={personalInfo.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="hover:text-emerald-400 transition-colors"
        >
          <Github class="w-4 h-4" />
        </a>
        <a
          href={`mailto:${personalInfo.email}`}
          aria-label="Email"
          class="hover:text-emerald-400 transition-colors"
        >
          <Mail class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</footer>
