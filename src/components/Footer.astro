---
import { personalInfo } from '../data/portfolioData';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--line)] py-12 bg-[var(--paper)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Left: Logo & Copyright -->
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <a href="#" class="rk-logo" style="font-size: 22px;">
        mehedi
      </a>
      <span class="hidden sm:inline text-[var(--ink-muted)]">·</span>
      <small class="font-sans-clean text-xs text-[var(--ink-muted)]">
        &copy; {currentYear} Md. Mehedi Hassan. All rights reserved.
      </small>
    </div>

    <!-- Center: Built with Astro -->
    <div class="font-mono-clean text-xs text-[var(--ink-muted)]">
      Built with <span class="font-bold text-[var(--ink)]">Astro</span> & <span class="font-bold text-[var(--ink)]">Tailwind CSS</span>
    </div>

    <!-- Right: Links & Back to Top -->
    <div class="flex items-center gap-6 font-mono-clean text-xs font-semibold text-[var(--ink-soft)]">
      <a href={personalInfo.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--red)] transition-colors">
        LinkedIn ↗
      </a>
      <a href={personalInfo.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--red)] transition-colors">
        GitHub ↗
      </a>
      <a href="#" class="font-bold text-[var(--ink)] hover:text-[var(--red)] transition-colors">
        back to top ↑
      </a>
    </div>
  </div>
</footer>
