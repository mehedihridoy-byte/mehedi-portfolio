---
import { personalInfo, keyMetrics } from '../data/portfolioData';
---

<section id="home" class="pt-16 pb-20 md:pt-24 md:pb-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    <!-- Top Eyebrow + Pill -->
    <div class="flex flex-wrap items-center gap-3 mb-6">
      <span class="rk-eyebrow">00 · OPERATIONS LEAD & SPREADSHEET SPECIALIST</span>
      <span class="rk-sticker rk-fill-lime" style="transform: rotate(-1.5deg);">
        {personalInfo.statusBadge} ✓
      </span>
    </div>

    <!-- Main Hero Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <!-- Left Hero Headline & Bio (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-[var(--ink)] leading-[1.05]">
          Automating business operations with 
          <span class="rk-squiggle text-[var(--ink)]">
            Google Sheets
            <svg viewBox="0 0 600 28" preserveAspectRatio="none" aria-hidden="true">
              <path d="M4 16 Q 40 2 76 16 T 148 16 T 220 16 T 292 16 T 364 16 T 436 16 T 508 16 T 580 16" fill="none" stroke="var(--red)" stroke-width="7" stroke-linecap="round"></path>
            </svg>
          </span>
          {" "}&amp; Excel precision<span class="text-[var(--red)]">.</span>
        </h1>

        <p class="text-lg sm:text-xl text-[var(--ink-soft)] leading-relaxed font-sans-clean max-w-2xl">
          I'm <strong class="text-[var(--ink)] font-bold">{personalInfo.name}</strong>, Operations Lead at Shikho Technologies Bangladesh. With 5+ years scaling operations across 12,000+ workflows and content operations, I help business owners and teams replace tedious manual work with automated, error-free Google Sheets and dynamic Excel models.
        </p>

        <!-- CTA Buttons + Handwritten Caveat Callout -->
        <div class="pt-2 flex flex-wrap items-center gap-4 relative">
          <a href="#work" class="rk-btn rk-btn--ink">
            Explore Sheet Projects ↗
          </a>
          <a href={personalInfo.resumeUrl} target="_blank" class="rk-btn rk-btn--out">
            Download CV (PDF) ↓
          </a>

          <!-- Handwritten Note Arrow (Caveat font) -->
          <div class="hidden sm:flex items-center gap-2 font-hand text-2xl text-[var(--red)] ml-2" style="transform: rotate(-3deg);">
            <svg width="34" height="28" viewBox="0 0 40 30" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="inline-block">
              <path d="M8 22 C 18 10, 28 8, 36 16"></path>
              <path d="M30 18 L 36 16 L 35 10"></path>
            </svg>
            <span>120+ hours saved every month!</span>
          </div>
        </div>
      </div>

      <!-- Right Card: Neo-brutalist Portrait & Live Spreadsheet Engine Card (5 cols) -->
      <div class="lg:col-span-5">
        <div class="rk-card p-6 sm:p-7 space-y-5 relative bg-[var(--surface)]">
          <!-- Portrait Header with Tilted Sticker -->
          <div class="flex items-center gap-4 pb-4 border-b border-[var(--line)]">
            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl border-2 border-[var(--ink)] shadow-[var(--shadow-sticker)] overflow-hidden shrink-0 bg-[var(--paper)]">
              <img
                src={personalInfo.photoUrl}
                alt="Md. Mehedi Hassan"
                class="w-full h-full object-cover object-top"
                loading="eager"
              />
            </div>
            <div class="space-y-1">
              <span class="rk-sticker rk-fill-butter text-[11px]" style="transform: rotate(1.5deg);">
                Operations Lead @ Shikho
              </span>
              <div class="font-display font-bold text-base text-[var(--ink)] leading-tight pt-1">
                Md. Mehedi Hassan
              </div>
              <div class="font-mono-clean text-xs text-[var(--ink-muted)]">
                5+ Yrs Ops & Data
              </div>
            </div>
          </div>

          <!-- Simulated Live Formula & Code Execution (100% Sheet / Excel Oriented) -->
          <div class="font-mono-clean text-xs space-y-2 p-3.5 rounded-xl bg-[var(--paper)] border border-[var(--line)]">
            <div class="text-[var(--ink-muted)]">// Automated Spreadsheet & Workflow Engine</div>
            <div>
              <span class="text-[var(--red)] font-bold">=QUERY</span>(master_spreadsheets, 
            </div>
            <div class="pl-3 text-[var(--ink-soft)]">
              "SELECT Sheet_ID, Task, SLA_Status"
            </div>
            <div class="pl-3 text-[var(--ink-soft)]">
              "WHERE Automated = TRUE AND Errors = 0")
            </div>
            <div class="mt-2 pt-2 border-t border-[var(--line)] flex items-center justify-between text-[11px]">
              <span class="text-[var(--ink-muted)]">Workflows & Content Scaled:</span>
              <span class="font-bold text-[var(--ink)] bg-[var(--lime)] px-2 py-0.5 rounded border border-[var(--ink)]">12,000+ Automated</span>
            </div>
          </div>

          <!-- Highlight Stats Grid (Updated: Content & Workflows) -->
          <div class="grid grid-cols-2 gap-3 pt-1">
            <div class="p-3 rounded-xl border border-[var(--line)] bg-[var(--surface)] text-center">
              <div class="font-display text-2xl sm:text-3xl font-extrabold text-[var(--ink)]">12,000+</div>
              <div class="font-mono-clean text-[10px] text-[var(--ink-muted)] mt-0.5">Content & Workflows</div>
            </div>
            <div class="p-3 rounded-xl border border-[var(--line)] bg-[var(--surface)] text-center">
              <div class="font-display text-2xl sm:text-3xl font-extrabold text-[var(--ink)]">4,200+</div>
              <div class="font-mono-clean text-[10px] text-[var(--ink-muted)] mt-0.5">QA Audited & Verified</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
