---
import { ArrowUpRight, FileDown, Sparkles, CheckCircle2, Terminal, Table, Cpu, ShieldCheck } from 'lucide-astro';
import { personalInfo, keyMetrics } from '../data/portfolioData';
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Top Pill Status Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-medium mb-8 backdrop-blur-md shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span class="w-2 h-2 -ml-3 rounded-full bg-emerald-400"></span>
      <span>{personalInfo.statusBadge}</span>
    </div>

    <!-- Main Headline Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-8 space-y-6">
        <div>
          <h2 class="text-sm uppercase tracking-widest text-emerald-400 font-mono font-semibold mb-3">
            Operations & Data Analytics
          </h2>
          <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white leading-[1.1]">
            Md. Mehedi <br />
            <span class="bg-gradient-to-r from-slate-100 via-emerald-200 to-teal-400 bg-clip-text text-transparent">
              Hassan
            </span>
          </h1>
        </div>

        <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed max-w-2xl">
          {personalInfo.tagline}
        </p>

        <p class="text-sm sm:text-base text-slate-400 max-w-2xl leading-relaxed">
          {personalInfo.shortBio}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-3">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-500 text-slate-950 font-semibold text-sm hover:bg-emerald-400 transition-all shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/30 hover:-translate-y-0.5"
          >
            <span>Explore Case Studies</span>
            <ArrowUpRight class="w-4 h-4" />
          </a>

          <a
            href={personalInfo.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 border border-slate-700/80 font-medium text-sm transition-all hover:border-emerald-500/40 hover:-translate-y-0.5"
          >
            <FileDown class="w-4 h-4 text-emerald-400" />
            <span>Download CV (PDF)</span>
          </a>

          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-slate-400 hover:text-white font-medium text-sm transition-colors"
          >
            <span>Get in Touch</span>
          </a>
        </div>
      </div>

      <!-- Right Bento Hero Visual Box -->
      <div class="lg:col-span-4">
        <div class="bento-card p-6 border border-white/[0.08] relative overflow-hidden group">
          <!-- Ambient card glow -->
          <div class="absolute -top-16 -right-16 w-36 h-36 bg-emerald-500/10 blur-2xl rounded-full"></div>
          
          <div class="flex items-center justify-between pb-4 border-b border-white/[0.06]">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            </div>
            <span class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
              ops_engine.gs
            </span>
          </div>

          <!-- Simulated Live Code / Script Snippet -->
          <div class="pt-4 font-mono text-xs text-slate-300 space-y-2.5">
            <div class="text-slate-500">// Automated Ops Pipeline</div>
            <div>
              <span class="text-teal-400">function</span> <span class="text-emerald-300">syncOpsData</span>() {'{'}
            </div>
            <div class="pl-4 text-slate-400">
              <span class="text-slate-500">const</span> raw = <span class="text-cyan-300">importDailyRecords</span>();
            </div>
            <div class="pl-4 text-slate-400">
              <span class="text-slate-500">const</span> clean = <span class="text-cyan-300">validateIntegrity</span>(raw);
            </div>
            <div class="pl-4 text-emerald-400 bg-emerald-500/[0.07] py-1 px-1.5 rounded border border-emerald-500/20">
              ▶ dispatchAlerts(&#123; status: <span class="text-white">"100% Synced"</span> &#125;);
            </div>
            <div class="pl-4 text-slate-400">
              <span class="text-teal-400">return</span> <span class="text-cyan-300">renderExecutiveKPIs</span>(clean);
            </div>
            <div>{'}'}</div>
          </div>

          <!-- Quick Value Badges -->
          <div class="mt-6 pt-4 border-t border-white/[0.06] grid grid-cols-2 gap-2 text-center font-mono">
            <div class="bg-slate-900/60 p-2.5 rounded-lg border border-white/[0.04]">
              <div class="text-[10px] text-slate-400">DAILY RUNS</div>
              <div class="text-sm font-bold text-emerald-400">Auto Triggered</div>
            </div>
            <div class="bg-slate-900/60 p-2.5 rounded-lg border border-white/[0.04]">
              <div class="text-[10px] text-slate-400">INTEGRITY</div>
              <div class="text-sm font-bold text-cyan-400">100% Enforced</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Metrics Bento Banner (Row of 4 highlights) -->
    <div class="mt-14 grid grid-cols-2 lg:grid-cols-4 gap-4">
      {keyMetrics.map((metric) => (
        <div class="bento-card p-5 border border-white/[0.06] hover:border-emerald-500/30 transition-all">
          <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-mono bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent">
            {metric.value}
          </div>
          <div class="text-sm font-semibold text-slate-200 mt-1">
            {metric.label}
          </div>
          <div class="text-xs text-slate-400 mt-0.5">
            {metric.subtext}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
