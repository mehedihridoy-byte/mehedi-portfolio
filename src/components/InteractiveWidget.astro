---
import { Calculator, Sparkles, Clock, DollarSign, TrendingUp, ArrowRight } from 'lucide-astro';
---

<section class="py-12 relative border-t border-white/[0.05]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="bento-card p-6 sm:p-8 border border-emerald-500/30 bg-gradient-to-br from-[#0B0F17] via-[#0E1522] to-[#0B0F17] relative overflow-hidden">
      <!-- Glow ambient background -->
      <div class="absolute -top-24 -left-24 w-72 h-72 bg-emerald-500/10 blur-[100px] rounded-full pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-cyan-500/10 blur-[100px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Left: Simulator Controls -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 text-[11px] font-mono font-medium text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20">
              <Calculator class="w-3.5 h-3.5" />
              <span>INTERACTIVE ROI SIMULATOR</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
              Calculate Your Operational Hours & Cost Savings
            </h3>
            <p class="text-slate-300 text-xs sm:text-sm">
              See what happens when repetitive spreadsheet chores and manual copy-pasting are transformed into automated, zero-touch pipelines.
            </p>
          </div>

          <!-- Controls -->
          <div class="space-y-4 pt-2 font-mono text-xs">
            <!-- Slider 1: Team Size -->
            <div class="space-y-1.5">
              <div class="flex justify-between text-slate-300">
                <span>Operational Team Size:</span>
                <span id="team-size-val" class="font-bold text-emerald-400">5 members</span>
              </div>
              <input
                id="team-size-input"
                type="range"
                min="1"
                max="50"
                value="5"
                class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-400"
              />
            </div>

            <!-- Slider 2: Hours spent per week -->
            <div class="space-y-1.5">
              <div class="flex justify-between text-slate-300">
                <span>Manual Hours / Person / Week:</span>
                <span id="hours-val" class="font-bold text-cyan-400">8 hours</span>
              </div>
              <input
                id="hours-input"
                type="range"
                min="2"
                max="25"
                value="8"
                class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
              />
            </div>

            <!-- Slider 3: Hourly Rate -->
            <div class="space-y-1.5">
              <div class="flex justify-between text-slate-300">
                <span>Estimated Blended Hourly Rate:</span>
                <span id="rate-val" class="font-bold text-amber-400">$25 / hr</span>
              </div>
              <input
                id="rate-input"
                type="range"
                min="10"
                max="100"
                step="5"
                value="25"
                class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-400"
              />
            </div>
          </div>
        </div>

        <!-- Right: Real-time Calculated Impact Card -->
        <div class="lg:col-span-5 bg-slate-900/80 p-6 rounded-2xl border border-white/[0.08] shadow-2xl space-y-6">
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider pb-2 border-b border-white/[0.06] flex items-center justify-between">
            <span>Projected Annual Impact</span>
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>

          <div class="space-y-4">
            <div>
              <div class="text-[11px] font-mono text-slate-400">MONTHLY TIME RECLAIMED</div>
              <div id="monthly-hours-result" class="text-3xl sm:text-4xl font-extrabold text-emerald-400 font-mono tracking-tight">
                135 hrs
              </div>
              <div class="text-xs text-slate-400 mt-0.5">Automated workflow execution</div>
            </div>

            <div class="grid grid-cols-2 gap-3 pt-3 border-t border-white/[0.06]">
              <div>
                <div class="text-[10px] font-mono text-slate-400">EST. ANNUAL VALUE</div>
                <div id="annual-savings-result" class="text-xl sm:text-2xl font-bold text-white font-mono">
                  $40,500
                </div>
              </div>
              <div>
                <div class="text-[10px] font-mono text-slate-400">EFFICIENCY GAIN</div>
                <div class="text-xl sm:text-2xl font-bold text-cyan-400 font-mono">
                  85% Faster
                </div>
              </div>
            </div>
          </div>

          <a
            href="#contact"
            class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-xs transition-colors shadow-md shadow-emerald-500/20"
          >
            <span>Let's Automate Your Operations</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupRoiCalculator() {
    const teamInput = document.getElementById('team-size-input') as HTMLInputElement | null;
    const hoursInput = document.getElementById('hours-input') as HTMLInputElement | null;
    const rateInput = document.getElementById('rate-input') as HTMLInputElement | null;

    const teamVal = document.getElementById('team-size-val');
    const hoursVal = document.getElementById('hours-val');
    const rateVal = document.getElementById('rate-val');

    const monthlyHoursRes = document.getElementById('monthly-hours-result');
    const annualSavingsRes = document.getElementById('annual-savings-result');

    function recalculate() {
      if (!teamInput || !hoursInput || !rateInput) return;
      const team = parseInt(teamInput.value, 10);
      const hours = parseInt(hoursInput.value, 10);
      const rate = parseInt(rateInput.value, 10);

      if (teamVal) teamVal.textContent = `${team} members`;
      if (hoursVal) hoursVal.textContent = `${hours} hours`;
      if (rateVal) rateVal.textContent = `$${rate} / hr`;

      // Calculation: team * hours * 4.2 weeks/mo * 82% automation rate
      const monthlyHoursSaved = Math.round(team * hours * 4.2 * 0.82);
      const annualDollarSaved = Math.round(monthlyHoursSaved * 12 * rate);

      if (monthlyHoursRes) monthlyHoursRes.textContent = `${monthlyHoursSaved.toLocaleString()} hrs`;
      if (annualSavingsRes) annualSavingsRes.textContent = `$${annualDollarSaved.toLocaleString()}`;
    }

    teamInput?.addEventListener('input', recalculate);
    hoursInput?.addEventListener('input', recalculate);
    rateInput?.addEventListener('input', recalculate);
  }

  setupRoiCalculator();
</script>
