---
import { Database, Terminal, BarChart, Globe, Sparkles, BookOpen } from 'lucide-astro';
import { learningJourneyData } from '../data/portfolioData';

const iconMap: Record<string, any> = {
  Database,
  Terminal,
  BarChart,
  Globe,
};
---

<section id="learning" class="py-16 md:py-24 relative border-t border-white/[0.05]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Heading -->
    <div class="space-y-2 mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-medium text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
        <BookOpen class="w-3.5 h-3.5" />
        <span>EXPANDING STACK</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Active Learning & Technical Evolution
      </h2>
      <p class="text-slate-400 max-w-2xl text-base">
        Staying ahead of the curve by advancing into enterprise databases, programmatic data science, and modern web application development.
      </p>
    </div>

    <!-- Learning Cards Grid (2x2) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {learningJourneyData.map((item) => {
        const IconComponent = iconMap[item.icon] || Database;
        return (
          <div class="bento-card p-6 sm:p-7 border border-white/[0.08] hover:border-emerald-500/30 transition-all flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center">
                  <IconComponent class="w-5 h-5" />
                </div>
                <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-slate-900 border border-white/[0.08] text-emerald-400 font-medium">
                  {item.status}
                </span>
              </div>

              <div>
                <h3 class="text-lg font-bold text-white">
                  {item.skill}
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 mt-1 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>

            <!-- Progress Bar & Indicator -->
            <div class="space-y-2 pt-2 border-t border-white/[0.04]">
              <div class="flex justify-between text-xs font-mono">
                <span class="text-slate-400">Mastery Progress</span>
                <span class="text-cyan-400 font-bold">{item.progress}%</span>
              </div>
              <div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden border border-white/[0.05]">
                <div
                  class="h-full bg-gradient-to-r from-emerald-500 to-cyan-400 rounded-full transition-all duration-1000"
                  style={`width: ${item.progress}%`}
                ></div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
