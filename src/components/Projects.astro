---
import { ArrowUpRight, CheckCircle2, AlertCircle, Wrench, Sparkles, TrendingUp, Layers } from 'lucide-astro';
import { featuredProjects } from '../data/portfolioData';
---

<section id="projects" class="py-16 md:py-24 relative border-t border-white/[0.05]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Heading -->
    <div class="space-y-2 mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-medium text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
        <Sparkles class="w-3.5 h-3.5" />
        <span>FEATURED WORK & CASE STUDIES</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Engineered for Accuracy, Scalability, and Speed
      </h2>
      <p class="text-slate-400 max-w-2xl text-base">
        Deep dives into practical operational problem-solving, advanced spreadsheet engineering, and automated systems.
      </p>
    </div>

    <!-- Projects List (Bento-style deep case studies) -->
    <div class="space-y-8">
      {featuredProjects.map((project, index) => (
        <article class="bento-card p-6 sm:p-8 lg:p-10 border border-white/[0.08] relative group">
          <!-- Ambient glow for top item -->
          {index === 0 && (
            <div class="absolute top-0 right-0 w-80 h-80 bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none"></div>
          )}

          <div class="relative z-10 space-y-6">
            <!-- Header Meta: Category, Badge & Counter -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-white/[0.06]">
              <div class="flex items-center gap-2.5">
                <span class="text-xs font-mono text-emerald-400 font-semibold uppercase tracking-wider">
                  {project.category}
                </span>
                {project.badge && (
                  <span class="text-[10px] font-mono bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full">
                    {project.badge}
                  </span>
                )}
              </div>
              <span class="text-xs font-mono text-slate-500">
                0{index + 1} / 0{featuredProjects.length}
              </span>
            </div>

            <!-- Title & Subtitle -->
            <div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight group-hover:text-emerald-300 transition-colors">
                {project.title}
              </h3>
              <p class="text-sm sm:text-base text-slate-300 mt-1 font-medium">
                {project.subtitle}
              </p>
            </div>

            <!-- Problem vs Solution Two-Column Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Problem Box -->
              <div class="bg-rose-950/20 border border-rose-900/30 p-4 sm:p-5 rounded-xl space-y-2">
                <div class="flex items-center gap-2 text-rose-400 font-mono text-xs font-semibold">
                  <AlertCircle class="w-4 h-4" />
                  <span>THE CHALLENGE</span>
                </div>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                  {project.problem}
                </p>
              </div>

              <!-- Solution Box -->
              <div class="bg-emerald-950/20 border border-emerald-900/30 p-4 sm:p-5 rounded-xl space-y-2">
                <div class="flex items-center gap-2 text-emerald-400 font-mono text-xs font-semibold">
                  <CheckCircle2 class="w-4 h-4" />
                  <span>THE ENGINEERED SOLUTION</span>
                </div>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                  {project.solution}
                </p>
              </div>
            </div>

            <!-- Outcomes & Metrics Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 pt-2">
              <!-- Key Outcomes Bullets (8 cols) -->
              <div class="lg:col-span-8 space-y-3">
                <h4 class="text-xs font-mono uppercase tracking-wider text-slate-400 flex items-center gap-2">
                  <TrendingUp class="w-3.5 h-3.5 text-emerald-400" />
                  <span>Key Measurable Outcomes</span>
                </h4>
                <ul class="space-y-2">
                  {project.outcomes.map((outcome) => (
                    <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mt-2 shrink-0"></span>
                      <span>{outcome}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Metrics Cards (4 cols) -->
              <div class="lg:col-span-4 grid grid-cols-3 lg:grid-cols-1 gap-2.5">
                {project.metrics.map((m) => (
                  <div class="bg-slate-900/70 p-3 rounded-xl border border-white/[0.05] text-center lg:text-left flex flex-col justify-center">
                    <span class="text-lg sm:text-xl font-bold font-mono text-emerald-400 tracking-tight">
                      {m.value}
                    </span>
                    <span class="text-[11px] font-mono text-slate-400 uppercase tracking-tighter mt-0.5">
                      {m.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Footer: Tech Stack Pills & Action -->
            <div class="pt-4 border-t border-white/[0.06] flex flex-wrap items-center justify-between gap-3">
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="text-[11px] font-mono text-slate-500 mr-1 flex items-center gap-1">
                  <Wrench class="w-3 h-3" /> Stack:
                </span>
                {project.tools.map((t) => (
                  <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-slate-900 text-slate-300 border border-white/[0.06]">
                    {t}
                  </span>
                ))}
              </div>

              <a
                href="#contact"
                class="inline-flex items-center gap-1 text-xs font-mono text-emerald-400 hover:text-emerald-300 transition-colors py-1 group/btn"
              >
                <span>Request Case Study Details</span>
                <ArrowUpRight class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
