---
import { featuredProjects } from '../data/portfolioData';

const cardStickerColors = ["rk-fill-lime", "rk-fill-sky", "rk-fill-butter", "rk-fill-pink", "rk-fill-lime"];
---

<section id="work" class="py-20 border-t border-[var(--line)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    <div class="mb-14">
      <span class="rk-eyebrow">03 · CASE STUDIES & IMPACT</span>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink)] mt-2">
        Flagship work built under real constraints<span class="text-[var(--red)]">.</span>
      </h2>
      <p class="text-[var(--ink-muted)] text-base sm:text-lg mt-2 max-w-2xl font-sans-clean">
        Deep dives into how spreadsheet engineering, automation scripts, and workflow optimization delivered measurable business value.
      </p>
    </div>

    <!-- Case Studies Stacked Cards -->
    <div class="space-y-10">
      {featuredProjects.map((project, idx) => (
        <article class="rk-card p-6 sm:p-10 space-y-6">
          <!-- Card Header -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--line)]">
            <div class="flex items-center gap-3">
              <span class={`rk-sticker ${cardStickerColors[idx % cardStickerColors.length]}`}>
                {project.category}
              </span>
              {project.badge && (
                <span class="font-mono-clean text-xs font-bold text-[var(--red)]">
                  ★ {project.badge}
                </span>
              )}
            </div>
            <span class="font-mono-clean text-sm font-bold text-[var(--ink-muted)]">
              0{idx + 1} / 0{featuredProjects.length}
            </span>
          </div>

          <!-- Title & Subtitle -->
          <div>
            <h3 class="font-display text-2xl sm:text-4xl font-extrabold text-[var(--ink)] tracking-tight">
              {project.title}
            </h3>
            <p class="text-base sm:text-lg text-[var(--ink-soft)] font-medium mt-1">
              {project.subtitle}
            </p>
          </div>

          <!-- Problem vs Solution Two Columns -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2">
            <!-- Problem -->
            <div class="p-5 rounded-2xl bg-[var(--paper)] border border-[var(--line)] space-y-2">
              <span class="font-mono-clean text-xs font-bold text-[var(--red)] uppercase tracking-wider block">
                The Bottleneck:
              </span>
              <p class="text-xs sm:text-sm text-[var(--ink-soft)] leading-relaxed font-sans-clean">
                {project.problem}
              </p>
            </div>

            <!-- Solution -->
            <div class="p-5 rounded-2xl bg-[var(--paper)] border border-[var(--line)] space-y-2">
              <span class="font-mono-clean text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider block">
                The Engineered Solution:
              </span>
              <p class="text-xs sm:text-sm text-[var(--ink-soft)] leading-relaxed font-sans-clean">
                {project.solution}
              </p>
            </div>
          </div>

          <!-- Outcomes & Metrics -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 pt-3 items-center">
            <!-- Key Outcomes Bullets (8 cols) -->
            <div class="lg:col-span-8 space-y-2">
              <span class="font-mono-clean text-xs uppercase tracking-wider text-[var(--ink-muted)] block">
                Measurable Impact:
              </span>
              <ul class="space-y-1.5 font-sans-clean text-xs sm:text-sm text-[var(--ink-soft)]">
                {project.outcomes.map((outcome) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[var(--red)] font-bold">✓</span>
                    <span>{outcome}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Big Stats Pills (4 cols) -->
            <div class="lg:col-span-4 grid grid-cols-3 gap-2">
              {project.metrics.map((m) => (
                <div class="p-3 rounded-xl border border-[var(--line)] bg-[var(--surface)] text-center">
                  <div class="font-display font-extrabold text-xl sm:text-2xl text-[var(--ink)]">
                    {m.value}
                  </div>
                  <div class="font-mono-clean text-[10px] text-[var(--ink-muted)] uppercase tracking-tighter mt-0.5">
                    {m.label}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Card Footer: Tools & Request Details -->
          <div class="pt-4 border-t border-[var(--line)] flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-1.5 font-mono-clean text-xs">
              <span class="text-[var(--ink-muted)] mr-1">Tools:</span>
              {project.tools.map((tool) => (
                <span class="px-2.5 py-1 rounded-lg border border-[var(--line)] bg-[var(--paper)] text-[var(--ink-soft)]">
                  {tool}
                </span>
              ))}
            </div>

            <a
              href="#contact"
              class="font-mono-clean text-xs font-bold text-[var(--ink)] hover:text-[var(--red)] transition-colors flex items-center gap-1"
            >
              <span>Discuss this case study</span>
              <span>↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
