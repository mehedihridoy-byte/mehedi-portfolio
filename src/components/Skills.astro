---
import { skillsCategories } from '../data/portfolioData';

const toolsList = [
  { name: "Advanced Excel", color: "rk-fill-lime", tilt: "-2deg" },
  { name: "Google Sheets", color: "rk-fill-sky", tilt: "1.5deg" },
  { name: "Google Apps Script", color: "rk-fill-butter", tilt: "-1.5deg" },
  { name: "Power Query", color: "rk-fill-pink", tilt: "2deg" },
  { name: "SQL (Postgres/MySQL)", color: "rk-fill-sky", tilt: "-2deg" },
  { name: "Python / Pandas", color: "rk-fill-butter", tilt: "1deg" },
  { name: "Power BI", color: "rk-fill-lime", tilt: "-1deg" },
  { name: "VBA & Macros", color: "rk-fill-pink", tilt: "2.5deg" },
  { name: "REST APIs & Webhooks", color: "rk-fill-sky", tilt: "-2deg" },
  { name: "Notion & Asana", color: "rk-fill-butter", tilt: "1.5deg" },
];

const categorySquareColors = ["rk-fill-lime", "rk-fill-sky", "rk-fill-butter", "rk-fill-pink"];
---

<section id="skills" class="py-20 border-t border-[var(--line)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 space-y-16">
    <!-- Section Header -->
    <div>
      <span class="rk-eyebrow">05 · SKILLS & METHODOLOGIES</span>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink)] mt-2">
        Working stack & core competencies<span class="text-[var(--red)]">.</span>
      </h2>
    </div>

    <!-- Skills 2x2 Grid with Square Indicators like Rifat's site -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skillsCategories.map((cat, idx) => (
        <div class="rk-card p-6 sm:p-8 space-y-5">
          <div class="flex items-center gap-3 pb-3 border-b border-[var(--line)]">
            <span class={`w-4 h-4 rounded-md border border-[var(--ink)] ${categorySquareColors[idx % categorySquareColors.length]}`} aria-hidden="true"></span>
            <h3 class="font-display text-xl font-bold text-[var(--ink)]">
              {cat.category}
            </h3>
          </div>

          <div class="flex flex-wrap gap-2 pt-1 font-mono-clean text-xs">
            {cat.skills.map((skill) => (
              <span class={`px-3 py-1.5 rounded-lg border border-[var(--line)] transition-all ${skill.highlight ? 'bg-[var(--surface-hover)] font-bold text-[var(--ink)] shadow-sm' : 'bg-[var(--paper)] text-[var(--ink-soft)]'}`}>
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Tilted Stickers Shelf: "TOOLS I REACH FOR" (Signature Rifat bin Alam Element!) -->
    <div class="rk-card p-8 sm:p-10 space-y-6 bg-[var(--surface)]">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-[var(--line)]">
        <span class="font-mono-clean text-xs uppercase tracking-widest text-[var(--ink-muted)] font-bold">
          TOOLS I REACH FOR DAILY
        </span>
        <span class="font-hand text-xl text-[var(--red)]" style="transform: rotate(-2deg);">
          tested in real operating trenches!
        </span>
      </div>

      <div class="flex flex-wrap gap-3 pt-2">
        {toolsList.map((tool) => (
          <span
            class={`rk-sticker ${tool.color} text-sm cursor-default hover:scale-110 transition-transform`}
            style={`transform: rotate(${tool.tilt});`}
          >
            {tool.name}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
