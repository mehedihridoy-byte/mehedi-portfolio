---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Expertise from '../components/Expertise.astro';
import Projects from '../components/Projects.astro';
import InteractiveWidget from '../components/InteractiveWidget.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Awards from '../components/Awards.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main id="main-content" class="w-full max-w-full overflow-x-clip">
    <Hero />
    <About />
    <Expertise />
    <Projects />
    <InteractiveWidget />
    <Experience />
    <Skills />
    <Awards />
    <Contact />
  </main>
  <Footer />
</Layout>
